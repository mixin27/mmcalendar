<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="145"
                android:startColor="#FCFDFF"
                android:centerColor="#F6F8FB"
                android:endColor="#EEF2F7"
                android:type="linear" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape>
            <solid android:color="#00FFFFFF" />
            <corners android:radius="17dp" />
            <stroke
                android:width="1dp"
                android:color="#D8DFE8" />
            <padding
                android:left="12dp"
                android:top="12dp"
                android:right="12dp"
                android:bottom="12dp" />
        </shape>
    </item>
</layer-list>
