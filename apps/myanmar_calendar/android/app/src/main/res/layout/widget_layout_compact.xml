<?xml version="1.0" encoding="utf-8"?>
<!--
    COMPACT DATE WIDGET (2x1 or 2x2)
    Purpose: Minimal Myanmar date display for maximum screen real estate
    Features: Myanmar date, Western date (optional), Today indicator
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    android:background="@drawable/widget_bg_compact">

    <!-- Western Date (Small, Top Left) -->
    <TextView
        android:id="@+id/western_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:text="12"
        android:textSize="28sp"
        android:textColor="#1A1A1A"
        android:fontFamily="sans-serif-medium"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/western_month"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/western_day"
        android:layout_alignBottom="@id/western_day"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="2dp"
        android:text="DEC"
        android:textSize="11sp"
        android:textColor="#666666"
        android:fontFamily="sans-serif-medium" />

    <!-- Today Indicator (Optional) -->
    <TextView
        android:id="@+id/today_indicator"
        android:layout_width="4dp"
        android:layout_height="4dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:background="@drawable/today_dot"
        android:visibility="gone" />

    <!-- Myanmar Date (Large, Center-Bottom) -->
    <TextView
        android:id="@+id/myanmar_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="8dp"
        android:text="၁၃၈၆ နတ်တော် လဆုတ် ၈ ရက်"
        android:textSize="16sp"
        android:textColor="#1A1A1A"
        android:fontFamily="sans-serif"
        android:maxLines="2"
        android:ellipsize="end" />

</RelativeLayout>