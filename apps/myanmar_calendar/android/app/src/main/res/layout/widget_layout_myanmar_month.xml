<?xml version="1.0" encoding="utf-8"?>
<!--
    MYANMAR MONTH CALENDAR WIDGET (4x4)
    Displays Myanmar calendar month with:
    - Myanmar dates (waxing/waning + fortnight day)
    - Moon phase indicators
    - Holiday markers
    - Today highlight
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg_calendar">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/myanmar_month_year"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="နတ်တော်"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/western_month_year"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="December 2024"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:alpha="0.78"
            android:gravity="center"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Weekday Headers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="2dp">

        <TextView android:id="@+id/weekday_1" style="@style/MyanmarWeekdayHeader" android:text="နွေ" />
        <TextView android:id="@+id/weekday_2" style="@style/MyanmarWeekdayHeader" android:text="လာ" />
        <TextView android:id="@+id/weekday_3" style="@style/MyanmarWeekdayHeader" android:text="ဂါ" />
        <TextView android:id="@+id/weekday_4" style="@style/MyanmarWeekdayHeader" android:text="ဟူး" />
        <TextView android:id="@+id/weekday_5" style="@style/MyanmarWeekdayHeader" android:text="ကြာ" />
        <TextView android:id="@+id/weekday_6" style="@style/MyanmarWeekdayHeader" android:text="သော" />
        <TextView android:id="@+id/weekday_7" style="@style/MyanmarWeekdayHeader" android:text="နေ" />
    </LinearLayout>

