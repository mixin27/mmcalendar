<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background_gradient_blue">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Myanmar Calendar"
            android:textSize="15sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Calendar" />
    </LinearLayout>

    <!-- Separator -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#40FFFFFF"
        android:layout_marginBottom="12dp" />

    <!-- Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:weightSum="10">

        <!-- Moon Section (40%) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="12dp">

            <ImageView
                android:id="@+id/moon_phase_image"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:contentDescription="Moon Phase"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/moon_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Moon"
                android:textSize="12sp"
                android:textColor="#FFD700"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="6dp"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/last_updated_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last updated"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:layout_marginTop="4dp"
                android:textAlignment="center"
                />


            <TextView
                android:id="@+id/last_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last updated"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:layout_marginTop="2dp"
                android:textAlignment="center"
                />
        </LinearLayout>

        <!-- Date Section (60%) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="6"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <!-- Myanmar Date -->
            <TextView
                android:id="@+id/myanmar_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Myanmar Date"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="3dp"
                android:layout_marginBottom="6dp" />

            <!-- Western Date -->
            <TextView
                android:id="@+id/western_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Western Date"
                android:textSize="13sp"
                android:textColor="#E0E0E0"
                android:fontFamily="sans-serif"
                android:layout_marginBottom="12dp" />

            <!-- Separator -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#30FFFFFF"
                android:layout_marginBottom="10dp" />

            <!-- Holidays -->
            <TextView
                android:id="@+id/holidays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="11sp"
                android:textColor="#FF6B6B"
                android:background="@drawable/holiday_badge"
                android:padding="8dp"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <!-- Astrology -->
            <TextView
                android:id="@+id/astrology_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="10sp"
                android:textColor="#E0E0E0"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="2dp"
                android:maxLines="3"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hidden -->
    <TextView android:id="@+id/moon_phase" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
</LinearLayout>