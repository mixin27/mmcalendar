<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/widget_background_gradient_blue">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Myanmar Calendar"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Calendar" />
    </LinearLayout>

    <!-- Divider Line (using TextView as separator) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#40FFFFFF"
        android:layout_marginBottom="16dp" />

    <!-- Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Moon -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.4"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/moon_phase_image"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:contentDescription="Moon Phase"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/moon_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Moon"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Dates & Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.6"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_marginStart="20dp">

            <TextView
                android:id="@+id/myanmar_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Myanmar Date"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/western_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Western Date"
                android:textSize="14sp"
                android:textColor="#E0E0E0"
                android:fontFamily="sans-serif"
                android:layout_marginBottom="16dp" />

            <!-- Divider (using TextView) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#40FFFFFF"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/holidays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="#FF6B6B"
                android:background="@drawable/holiday_badge"
                android:padding="10dp"
                android:visibility="gone"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/astrology_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="11sp"
                android:textColor="#E0E0E0"
                android:fontFamily="sans-serif"
                android:maxLines="3"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hidden -->
    <TextView android:id="@+id/moon_phase" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
</LinearLayout>