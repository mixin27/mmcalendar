<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg_full">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <ImageView
            android:id="@+id/widget_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_calendar"
            android:tint="#F7FBFF"
            android:alpha="0.95" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Myanmar Calendar"
            android:textSize="12sp"
            android:textColor="#F7FBFF"
            android:alpha="0.92"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/today_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TODAY"
            android:textSize="9sp"
            android:textColor="#1A2738"
            android:background="@drawable/today_badge_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="6"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_marginEnd="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/western_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12"
                    android:textSize="34sp"
                    android:textColor="#F7FBFF"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/western_month"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="December"
                        android:textSize="12sp"
                        android:textColor="#F7FBFF"
                        android:alpha="0.92"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/western_year"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2024"
                        android:textSize="10sp"
                        android:textColor="#E6EEF8"
                        android:alpha="0.82" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#FFFFFF"
                android:alpha="0.18"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/myanmar_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="၁၃၈၆ နတ်တော် လဆုတ် ၈ ရက်"
                android:textSize="14sp"
                android:textColor="#F7FBFF"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/holidays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="🎉 Independence Day"
                android:textSize="10sp"
                android:textColor="#FFE08A"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/moon_phase_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:contentDescription="Moon Phase" />
            </FrameLayout>

            <TextView
                android:id="@+id/moon_phase_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Full Moon"
                android:textSize="11sp"
                android:textColor="#FFE08A"
                android:fontFamily="sans-serif-medium"
                android:textAlignment="center"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/fortnight_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="၁၅ ရက်"
                android:textSize="10sp"
                android:textColor="#E6EEF8"
                android:alpha="0.85"
                android:textAlignment="center"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/astrology_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Sabbath • Yatyaza • Pyathada"
        android:textSize="10sp"
        android:textColor="#E6EEF8"
        android:alpha="0.86"
        android:fontFamily="sans-serif"
        android:maxLines="2"
        android:ellipsize="end"
        android:visibility="gone" />

    <TextView
        android:id="@+id/last_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Updated: 7:36 AM"
        android:textSize="8sp"
        android:textColor="#E6EEF8"
        android:alpha="0.60"
        android:gravity="end"
        android:visibility="gone" />

</LinearLayout>
