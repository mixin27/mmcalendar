<?xml version="1.0" encoding="utf-8"?>
<!--
    MONTHLY CALENDAR WIDGET (4x4) - COMPLETE WITH ALL CELLS
    Purpose: Mini calendar grid showing the current month
    Features: 7x6 grid, Today highlight, Moon phases, Holidays
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg_calendar">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <!-- Month/Year -->
        <TextView
            android:id="@+id/month_year"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="December 2024"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium" />

        <!-- Myanmar Month -->
        <TextView
            android:id="@+id/myanmar_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="နတ်တော်"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:alpha="0.8" />
    </LinearLayout>

    <!-- Weekday Headers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <TextView android:id="@+id/weekday_sun" style="@style/WeekdayHeader" android:text="S" />
        <TextView android:id="@+id/weekday_mon" style="@style/WeekdayHeader" android:text="M" />
        <TextView android:id="@+id/weekday_tue" style="@style/WeekdayHeader" android:text="T" />
        <TextView android:id="@+id/weekday_wed" style="@style/WeekdayHeader" android:text="W" />
        <TextView android:id="@+id/weekday_thu" style="@style/WeekdayHeader" android:text="T" />
        <TextView android:id="@+id/weekday_fri" style="@style/WeekdayHeader" android:text="F" />
        <TextView android:id="@+id/weekday_sat" style="@style/WeekdayHeader" android:text="S" />
    </LinearLayout>

    <!-- Calendar Grid - 6 Weeks × 7 Days = 42 Cells -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Week 1 -->
        <LinearLayout style="@style/CalendarWeekRow">
            <TextView android:id="@+id/day_1" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_2" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_3" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_4" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_5" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_6" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_7" style="@style/CalendarDayCell" />
        </LinearLayout>

        <!-- Week 2 -->
        <LinearLayout style="@style/CalendarWeekRow">
            <TextView android:id="@+id/day_8" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_9" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_10" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_11" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_12" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_13" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_14" style="@style/CalendarDayCell" />
        </LinearLayout>

        <!-- Week 3 -->
        <LinearLayout style="@style/CalendarWeekRow">
            <TextView android:id="@+id/day_15" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_16" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_17" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_18" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_19" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_20" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_21" style="@style/CalendarDayCell" />
        </LinearLayout>

        <!-- Week 4 -->
        <LinearLayout style="@style/CalendarWeekRow">
            <TextView android:id="@+id/day_22" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_23" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_24" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_25" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_26" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_27" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_28" style="@style/CalendarDayCell" />
        </LinearLayout>

        <!-- Week 5 -->
        <LinearLayout style="@style/CalendarWeekRow">
            <TextView android:id="@+id/day_29" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_30" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_31" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_32" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_33" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_34" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_35" style="@style/CalendarDayCell" />
        </LinearLayout>

        <!-- Week 6 -->
        <LinearLayout style="@style/CalendarWeekRow">
            <TextView android:id="@+id/day_36" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_37" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_38" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_39" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_40" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_41" style="@style/CalendarDayCell" />
            <TextView android:id="@+id/day_42" style="@style/CalendarDayCell" />
        </LinearLayout>
    </LinearLayout>

    <!-- Today Info (Bottom) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <!-- Today Indicator -->
        <TextView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/today_dot" />

        <!-- Myanmar Date -->
        <TextView
            android:id="@+id/today_myanmar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="နတ်တော် လဆုတ် ၈ ရက်"
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:alpha="0.9"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Moon Phase Icon (Optional) -->
        <ImageView
            android:id="@+id/today_moon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_moon_full"
            android:alpha="0.8"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>