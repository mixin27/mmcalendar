<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:background="@android:color/white">

    <TextView
        android:id="@+id/widget_title"
        android:text="Myanmar Calendar"
        android:textSize="14sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:textColor="@android:color/black"/>

    <TextView
        android:id="@+id/widget_myanmar_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="4dp"
        android:text="7th Wagaung 1387 ME"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"/>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/widget_dow_en"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Monday"
                    android:textSize="20sp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@android:color/black"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/widget_day_en"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="27"
                    android:textSize="64sp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@android:color/black"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/widget_month_year_en"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="July, 2025"
                    android:textSize="18sp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@android:color/black"
                    android:gravity="center"/>

                <ImageView
                    android:id="@+id/widget_date_info_moon_phase"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="Moon Phase"
                    android:layout_gravity="center"
                    android:paddingTop="8dp"/>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:id="@+id/widget_astrology_day"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="astrologicalDay"
                    android:textSize="16sp"
                    android:textColor="@android:color/black"/>

                <TextView
                    android:id="@+id/widget_sabbath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="sabbath"
                    android:textSize="16sp"
                    android:textColor="@android:color/black"/>

                <TextView
                    android:id="@+id/widget_nagapor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="nagapor"
                    android:textSize="16sp"
                    android:textColor="@android:color/black"/>

                <TextView
                    android:id="@+id/widget_naga"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="naga"
                    android:textSize="16sp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@android:color/black"/>

                <TextView
                    android:id="@+id/widget_mahabote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="mahabote"
                    android:textSize="16sp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@android:color/black"/>

                <TextView
                    android:id="@+id/widget_nakhat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="nakhat"
                    android:textSize="16sp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@android:color/black"/>

                <TextView
                    android:id="@+id/widget_yearname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="yearname"
                    android:textSize="16sp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@android:color/black"/>
            </LinearLayout>

        </LinearLayout>


    </LinearLayout>

</LinearLayout>
