<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mmdate_moon_phase_root"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:background="@drawable/plugin_widget_bg">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="4"
        android:paddingEnd="4dp"
        android:paddingStart="8dp">

        <TextView
            android:id="@+id/mmdate_mp_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MyanmarCalendar"
            android:textSize="14sp"
            android:textColor="@android:color/black"/>

        <TextView
            android:id="@+id/mmdate_mp_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:text="Myanmar Date"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/mmdate_mp_moon_phase"
        android:layout_weight="1"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="Moon phase"
        android:paddingStart="0dp"
        android:layout_gravity="center"/>

</LinearLayout>
