<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/moon_phase_root"
    android:orientation="vertical"
    android:layout_width="180dp"
    android:layout_height="180dp"
    android:padding="8dp"
    android:background="@drawable/plugin_moon_phase_widget_bg">

    <TextView
        android:id="@+id/moon_phase_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MyanmarCalendar"
        android:textSize="14sp"
        android:textColor="@android:color/white"/>

    <TextView
        android:id="@+id/moon_phase_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Full Moon"
        android:textSize="16sp"
        android:textColor="@android:color/white"/>

    <ImageView
        android:id="@+id/widget_moon_phase"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="Moon Phase"
        android:layout_gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"/>


</LinearLayout>
