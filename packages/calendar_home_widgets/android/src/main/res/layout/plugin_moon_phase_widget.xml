<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/moon_phase_root"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:background="@drawable/plugin_moon_phase_widget_bg">

    <TextView
        android:id="@+id/moon_phase_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Moon Phase"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:paddingBottom="8dp"/>

    <ImageView
        android:id="@+id/widget_moon_phase"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Moon Phase"
        android:layout_gravity="center"
        android:paddingTop="8dp"/>

    <TextView
        android:id="@+id/moon_phase_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Full Moon"
        android:textSize="20sp"
        android:textColor="@android:color/white"
        android:layout_gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"/>
</LinearLayout>